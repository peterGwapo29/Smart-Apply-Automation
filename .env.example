# Monorepo Global Environment Example
# Note: Copy individual .env.example files inside backend, dashboard, and extension.

# Backend (Laravel API)
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobstreet_quick_apply
DB_USERNAME=root
DB_PASSWORD=

# Dashboard (Next.js)
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Chrome Extension (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
